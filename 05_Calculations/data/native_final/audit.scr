(defun bse-plan-length (d / pts q prev total first closed)
 (setq pts nil total 0.0)
 (foreach q d (if (= (car q) 10) (setq pts (append pts (list (cdr q))))))
 (if pts (progn (setq first (car pts) prev first)
 (foreach q (cdr pts) (setq total (+ total (distance prev q)) prev q))
 (if (= 1 (logand 1 (cdr (assoc 70 d)))) (setq total (+ total (distance prev first)))))) total)
(setq auditfile (open "C:/Users/lyuml-win/Desktop/polyu_bse3124/05_Calculations/data/native_final/native_entities.tsv" "w"))
(write-line (strcat "DRAWING\t" (getvar "DWGPREFIX") (getvar "DWGNAME")) auditfile)
(write-line (strcat "VERSION\t" (getvar "ACADVER")) auditfile)
(write-line (strcat "UNITS\t" (itoa (getvar "INSUNITS"))) auditfile)
(foreach pair (dictsearch (namedobjdict) "ACAD_LAYOUT") (if (= (car pair) 3) (write-line (strcat "LAYOUT\t" (cdr pair)) auditfile)))
