  {
    "layout": "TASK1-ROOM-REVIEW",
    "handle": "8028",
    "type": "AcDbMText",
    "layer": "E-T1-PAPER-NOTES",
    "TextString": "A3 LANDSCAPE | SCALE 1:75 | DIMENSIONS IN mm | PLANTROOM DETAIL",
    "InsertionPoint": [
      12.0,
